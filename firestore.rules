rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isPromoter() {
      return signedIn()
        && exists(/databases/$(database)/documents/promoters/$(request.auth.uid))
        && get(/databases/$(database)/documents/promoters/$(request.auth.uid)).data.role == 'promoter'
        && get(/databases/$(database)/documents/promoters/$(request.auth.uid)).data.active == true;
    }

    // Owners can view and manage every lead. Promoters can only create or
    // update leads that are tied to their Firebase Auth UID.
    match /leads/{leadId} {
      allow read: if isAdmin()
        || (isPromoter() && resource.data.promoterId == request.auth.uid);
      allow create: if isAdmin()
        || (isPromoter()
          && request.resource.data.promoterId == request.auth.uid
          && request.resource.data.shopId == get(/databases/$(database)/documents/promoters/$(request.auth.uid)).data.shopId);
      allow update: if isAdmin()
        || (isPromoter()
          && resource.data.promoterId == request.auth.uid
          && request.resource.data.promoterId == request.auth.uid
          && request.resource.data.shopId == get(/databases/$(database)/documents/promoters/$(request.auth.uid)).data.shopId);
      allow delete: if isAdmin();
    }

    // A minimal transfer event lets an offline promoter remove a reassigned
    // lead from the encrypted local cache without rereading all enquiries.
    match /leadAssignmentEvents/{eventId} {
      allow read: if isAdmin()
        || (isPromoter()
          && resource.data.previousPromoterId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /leadDeletionEvents/{eventId} {
      allow read: if isAdmin() || isPromoter();
      allow create, update, delete: if isAdmin();
    }

    // Comment edits are append-only audit records. Promoters can read only
    // their own history; admins can search all promoter/customer history.
    match /leadEditHistory/{editId} {
      allow read: if isAdmin()
        || (isPromoter() && resource.data.promoterId == request.auth.uid);
      allow create: if isAdmin()
        || (isPromoter()
          && request.resource.data.promoterId == request.auth.uid
          && request.resource.data.promoterName == get(/databases/$(database)/documents/promoters/$(request.auth.uid)).data.name
          && request.resource.data.keys().hasOnly([
            'recordId', 'customerName', 'promoterId', 'promoterName',
            'followUpNumber', 'changedAt', 'beforeComment', 'afterComment'
          ])
          && request.resource.data.keys().hasAll([
            'recordId', 'customerName', 'promoterId', 'promoterName',
            'followUpNumber', 'changedAt', 'beforeComment', 'afterComment'
          ])
          && request.resource.data.followUpNumber is int
          && request.resource.data.changedAt is timestamp
          && request.resource.data.beforeComment is string
          && request.resource.data.afterComment is string);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // The app may create only its own pending registration. Only an admin can
    // approve, assign, disable, or otherwise modify a promoter profile.
    match /promoters/{promoterId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == promoterId);
      allow create: if signedIn()
        && request.auth.uid == promoterId
        && !exists(/databases/$(database)/documents/promoterDeletions/$(promoterId))
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.role == 'promoter'
        && request.resource.data.active == false
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        && resource.data.status != 'deleting'
        && request.resource.data.status != 'deleting';
      allow delete: if false;
    }

    // A private uniqueness reservation keeps one promoter account per mobile.
    // It contains only the Firebase UID and cannot be listed by clients.
    match /promoterMobiles/{mobile} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/promoters/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/promoters/$(request.auth.uid)).data.mobile == mobile;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Permanent promoter deletion is queued for the existing GitHub Actions
    // worker, which uses the private Admin SDK service-account secret.
    match /promoterDeletionRequests/{promoterId} {
      function promoterIsInRecycleBin() {
        let profilePath = /databases/$(database)/documents/promoters/$(promoterId);
        let profile = get(profilePath).data;
        return exists(profilePath)
          && profile.role == 'promoter'
          && (profile.status == 'recycled'
            || profile.status == 'deleting'
            || ('deletedAt' in profile && profile.deletedAt != null));
      }

      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
          ['promoterId', 'requestedBy', 'status', 'requestedAt', 'error'])
        && request.resource.data.keys().hasAll(
          ['promoterId', 'requestedBy', 'status', 'requestedAt', 'error'])
        && request.resource.data.promoterId == promoterId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.error == null
        && promoterIsInRecycleBin();
      allow update: if isAdmin()
        && resource.data.status == 'failed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['requestedBy', 'status', 'requestedAt', 'error'])
        && request.resource.data.promoterId == promoterId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.error == null
        && promoterIsInRecycleBin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    match /shops/{shopId} {
      allow read: if isAdmin()
        || (isPromoter()
          && request.auth.token.shopIds is list
          && shopId in request.auth.token.shopIds);
      allow write: if false;
    }

    // Sales Tracker is currently available only to active owner accounts.
    // GitHub's scheduled backup uses a restricted Admin SDK service account
    // and therefore does not depend on client security rules.
    match /salesPersons/{personId} {
      allow read, write: if isAdmin();
    }

    match /salesPersonNames/{nameId} {
      allow read, write: if isAdmin();
    }

    match /salesEntries/{entryId} {
      allow read, write: if isAdmin();
    }

    match /salesEntryAudit/{auditId} {
      allow read, write: if isAdmin();
    }

    match /salesPersonTotalSnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /salesMonths/{monthId} {
      allow read, write: if isAdmin();
    }

    match /salesBackupRequests/{requestId} {
      allow read, write: if isAdmin();
    }

    // Inventory uses a separate namespace and the existing admin session.
    function inventoryLocation(location) {
      let path = /databases/$(database)/documents/is_locations/$(location);
      return location is string && (location in ['avadi', 'warehouse', 'tnhb', 'hotelmart'] || inventoryId(location))
        && (exists(path) ? get(path).data.active == true
                        : location in ['avadi', 'warehouse', 'tnhb', 'hotelmart']);
    }
    function inventoryType(type) {
      return type in ['opening', 'receipt', 'sale', 'customer_return',
                      'supplier_return', 'damage', 'adjustment', 'count'];
    }
    function inventoryId(id) {
      return id is string && id.matches('^[A-Za-z0-9]{20}$');
    }
    function inventoryText(text) {
      return text is string && text.size() <= 160;
    }
    function inventoryCost(cost) {
      return cost == null || (cost is int && cost >= 0 && cost <= 999999999);
    }
    function inventoryActiveSupplier(id) {
      return inventoryId(id) &&
        get(/databases/$(database)/documents/is_suppliers/$(id)).data.active == true;
    }
    function inventoryProduct(data) {
      let supplier = data.get('supplierId', null);
      return data.keys().hasOnly(['name','sku','category','reorder','active','actor','at','barcode','supplierId','unitCost'])
        && inventoryText(data.name) && inventoryText(data.sku) && inventoryText(data.category)
        && inventoryText(data.get('barcode', '')) && inventoryCost(data.get('unitCost', null))
        && (supplier == null || (inventoryId(supplier)
            && exists(/databases/$(database)/documents/is_suppliers/$(supplier))))
        && (data.reorder == null || (data.reorder is int && data.reorder >= 0 && data.reorder <= 1000000))
        && data.active is bool && data.actor == request.auth.uid && data.at == request.time;
    }
    function inventoryDraft(data) {
      return data.keys().hasOnly(['type','location','productId','quantity','note','actor','at'])
        && (data.type == null || inventoryType(data.type))
        && (data.location == null || inventoryLocation(data.location))
        && (data.productId == null || inventoryId(data.productId))
        && (data.quantity == null || (data.quantity is int && data.quantity >= -1000000 && data.quantity <= 1000000))
        && inventoryText(data.note) && data.actor == request.auth.uid && data.at == request.time;
    }
    function inventoryDelta(data) {
      return data.quantity is int && data.quantity >= -1000000 && data.quantity <= 1000000
        && data.delta is int && data.before is int && data.quantityAfter is int
        && data.before >= 0 && data.quantityAfter >= 0 && data.quantityAfter <= 1000000000
        && data.quantityAfter == data.before + data.delta
        && (data.type == 'count' ? data.quantity >= 0 && data.quantityAfter == data.quantity
          : data.type == 'adjustment' ? data.quantity != 0 && data.delta == data.quantity
          : data.quantity > 0 && (data.type in ['sale','supplier_return','damage','transfer_out']
            ? data.delta == -data.quantity : data.delta == data.quantity));
    }
    function inventoryPrior(path) {
      return exists(path) ? get(path).data.quantity : 0;
    }
    function inventoryPairedMovement(id, workflow, kind, product, location, units) {
      let path = /databases/$(database)/documents/is_movements/$(id);
      let move = getAfter(path).data;
      return inventoryId(id) && !exists(path) && move.workflowId == workflow
        && move.type == kind && move.productId == product && move.location == location
        && move.quantity == units && move.at == request.time && move.actor == request.auth.uid;
    }
    function inventoryOrderLinked(id, data) {
      let path = /databases/$(database)/documents/is_orders/$(data.workflowId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return after.lastReceiptId == id && after.productId == data.productId
        && after.location == data.location && after.received - before.received == data.quantity
        && after.updatedAt == request.time;
    }
    function inventoryTransferLinked(id, data) {
      let path = /databases/$(database)/documents/is_transfers/$(data.workflowId);
      let after = getAfter(path).data;
      return after.productId == data.productId && after.quantity == data.quantity
        && after.status == 'received'
        && (data.type == 'transfer_out'
          ? !exists(path) && after.dispatchId == id
              && after.from == data.location && after.at == request.time
          : (!exists(path) ? after.at == request.time : get(path).data.status == 'in_transit')
              && after.receiveId == id && after.to == data.location && after.receivedAt == request.time);
    }
    function inventoryMovementLink(id, data) {
      return inventoryType(data.type) ? !('workflowId' in data)
        : inventoryId(data.workflowId) && (data.type == 'purchase_receipt'
          ? inventoryOrderLinked(id, data)
          : data.type in ['transfer_out','transfer_in'] && inventoryTransferLinked(id, data));
    }
    function inventoryMovement(movementId, data) {
      let path = /databases/$(database)/documents/is_balances/$(data.balanceId);
      let product = /databases/$(database)/documents/is_products/$(data.productId);
      let after = getAfter(path).data;
      return data.keys().hasOnly(['type','location','productId','quantity','note','balanceId',
          'before','delta','quantityAfter','actor','at','workflowId'])
        && inventoryId(movementId) && inventoryId(data.productId)
        && inventoryLocation(data.location) && inventoryMovementLink(movementId, data)
        && data.balanceId == data.location + '_' + data.productId
        && inventoryText(data.note) && data.actor == request.auth.uid && data.at == request.time
        && data.before == inventoryPrior(path)
        && after.lastMovementId == movementId && after.productId == data.productId
        && after.location == data.location && after.quantity == data.quantityAfter
        && after.at == request.time
        && ((exists(product) && get(product).data.active == true && inventoryDelta(data))
          || inventoryProductFormMovement(product, path, data));
    }
    function inventoryProductFormMovement(product, balance, data) {
      let saved = getAfter(product).data;
      return saved.actor == request.auth.uid && saved.at == request.time
        && !('deletedAt' in saved)
        && ((data.type == 'opening' && !exists(balance)
            && ((data.quantity == 0 && data.quantity is int
                && data.delta == 0 && data.delta is int && data.quantityAfter == 0)
              || (saved.active == true && inventoryDelta(data))))
          || (data.type == 'count' && exists(product) && exists(balance)
            && saved.active == true && inventoryDelta(data)));
    }
    function inventoryBalance(balanceId, data) {
      let path = /databases/$(database)/documents/is_movements/$(data.lastMovementId);
      let movement = getAfter(path).data;
      return data.keys().hasOnly(['productId','location','quantity','lastMovementId','at'])
        && inventoryId(data.productId) && inventoryId(data.lastMovementId)
        && inventoryLocation(data.location) && balanceId == data.location + '_' + data.productId
        && data.quantity is int && data.quantity >= 0 && data.quantity <= 1000000000
        && data.at == request.time && !exists(path)
        && movement.balanceId == balanceId && movement.quantityAfter == data.quantity
        && movement.actor == request.auth.uid && movement.at == request.time;
    }
    match /is_locations/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && (inventoryId(id) || id in ['avadi','warehouse','tnhb','hotelmart'])
        && request.resource.data.keys().hasOnly(['name','active','actor','at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120 && request.resource.data.active is bool
        && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time;
    }
    match /is_products/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && inventoryId(id) && inventoryProduct(request.resource.data);
      allow update: if isAdmin() && inventoryId(id)
        && ((!('deletedAt' in resource.data) && inventoryProduct(request.resource.data))
          || inventoryRecycleProduct(resource.data, request.resource.data));
    }
    function inventoryRecycleProduct(old, data) {
      return data.diff(old).affectedKeys().hasOnly(['deletedAt','activeBeforeDelete','active','actor','at'])
        && data.actor == request.auth.uid && data.at == request.time
        && (!('deletedAt' in old)
          ? data.deletedAt == request.time && data.active == false && data.activeBeforeDelete == old.active
          : !('deletedAt' in data) && !('activeBeforeDelete' in data)
            && data.active == old.activeBeforeDelete);
    }
    match /is_drafts/{id} {
      allow create: if isAdmin() && inventoryId(id) && inventoryDraft(request.resource.data);
      allow read, delete: if isAdmin() && resource.data.actor == request.auth.uid;
      allow update: if isAdmin() && resource.data.actor == request.auth.uid && inventoryDraft(request.resource.data);
    }
    match /is_balances/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && inventoryBalance(id, request.resource.data);
    }
    match /is_movements/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && inventoryMovement(id, request.resource.data);
    }

    match /is_suppliers/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && inventoryId(id)
        && request.resource.data.keys().hasOnly(['name','phone','email','notes','active','actor','at'])
        && inventoryText(request.resource.data.name) && request.resource.data.name.size() > 0
        && inventoryText(request.resource.data.phone) && inventoryText(request.resource.data.email)
        && inventoryText(request.resource.data.notes) && request.resource.data.active is bool
        && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time;
    }

    function inventoryNewOrder(data) {
      return data.keys().hasOnly(['supplierId','productId','location','quantity','received',
          'unitCost','reference','status','lastReceiptId','actor','at','updatedAt'])
        && inventoryActiveSupplier(data.supplierId) && inventoryId(data.productId)
        && get(/databases/$(database)/documents/is_products/$(data.productId)).data.active == true
        && inventoryLocation(data.location) && data.quantity is int
        && data.quantity >= 1 && data.quantity <= 1000000 && data.received == 0
        && inventoryCost(data.unitCost) && inventoryText(data.reference)
        && data.status == 'ordered' && data.lastReceiptId == null
        && data.actor == request.auth.uid && data.at == request.time && data.updatedAt == request.time;
    }
    function inventoryUpdateOrder(id, old, data) {
      return old.status in ['ordered','partial'] && data.updatedAt == request.time
        && data.diff(old).affectedKeys().hasOnly(['received','status','lastReceiptId','updatedAt'])
        && (data.status == 'cancelled'
          ? data.received == old.received && data.lastReceiptId == old.lastReceiptId
          : data.received is int && data.received > old.received && data.received <= old.quantity
            && data.status == (data.received == old.quantity ? 'received' : 'partial')
            && inventoryPairedMovement(data.lastReceiptId,id,'purchase_receipt',
                old.productId,old.location,data.received - old.received));
    }
    match /is_orders/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && inventoryId(id) && inventoryNewOrder(request.resource.data);
      allow update: if isAdmin() && inventoryId(id) && inventoryUpdateOrder(id,resource.data,request.resource.data);
    }

    function inventoryNewTransfer(id, data) {
      return data.keys().hasOnly(['productId','from','to','quantity','status','dispatchId',
          'receiveId','receiptActor','receivedAt','actor','at'])
        && inventoryId(data.productId) && inventoryLocation(data.from) && inventoryLocation(data.to)
        && data.from != data.to && data.quantity is int && data.quantity >= 1 && data.quantity <= 1000000
        && data.status == 'received' && data.dispatchId != data.receiveId
        && data.actor == request.auth.uid && data.receiptActor == request.auth.uid
        && data.at == request.time && data.receivedAt == request.time
        && inventoryPairedMovement(data.dispatchId,id,'transfer_out',data.productId,data.from,data.quantity)
        && inventoryPairedMovement(data.receiveId,id,'transfer_in',data.productId,data.to,data.quantity);
    }
    function inventoryReceiveTransfer(id, old, data) {
      return old.status == 'in_transit' && data.status == 'received'
        && data.diff(old).affectedKeys().hasOnly(['status','receiveId','receiptActor','receivedAt'])
        && data.receivedAt == request.time && data.receiptActor == request.auth.uid
        && inventoryPairedMovement(data.receiveId,id,'transfer_in',old.productId,old.to,old.quantity);
    }
    match /is_transfers/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && inventoryId(id) && inventoryNewTransfer(id,request.resource.data);
      allow update: if isAdmin() && inventoryId(id) && inventoryReceiveTransfer(id,resource.data,request.resource.data);
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
